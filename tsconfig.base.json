{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "paths": {
      "@sdkwork/utils": [
        "../sdkwork-utils/packages/sdkwork-utils-typescript/src/index.ts"
      ],
      "@sdkwork/utils/*": [
        "../sdkwork-utils/packages/sdkwork-utils-typescript/src/*"
      ],
      "@sdkwork/sdk-common": [
        "../sdkwork-sdk-commons/sdkwork-sdk-common-typescript/src/index.ts"
      ],
      "@sdkwork/sdk-common/*": [
        "../sdkwork-sdk-commons/sdkwork-sdk-common-typescript/src/*"
      ]
    },
    "types": [
      "node",
      "@testing-library/jest-dom"
    ]
  }
}
