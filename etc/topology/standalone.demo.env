# Bootstrap profile standalone.demo — independent demonstration deployment, isolated from dev/test/staging/prod.
SDKWORK_MERCHANDISE_DEPLOYMENT_PROFILE=standalone
SDKWORK_MERCHANDISE_ENVIRONMENT=demo
SDKWORK_MERCHANDISE_PROFILE_ID=standalone.demo
SDKWORK_MERCHANDISE_APPLICATION_PUBLIC_HTTP_URL=https://merchandise-demo.sdkwork.com
SDKWORK_MERCHANDISE_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:8080
VITE_SDKWORK_MERCHANDISE_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:8080


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_MERCHANDISE_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN
SDKWORK_CORS_ALLOWED_ORIGINS=https://merchandise-demo.sdkwork.com,http://merchandise-demo.sdkwork.com,https://merchandise-demo.birdcoder.com,http://merchandise-demo.birdcoder.com,https://merchandise-demo.dtupay.com,http://merchandise-demo.dtupay.com,https://merchandise-demo.noaper.com,http://merchandise-demo.noaper.com,https://merchandise-demo.sdkwork.cn,http://merchandise-demo.sdkwork.cn,https://merchandise-demo.birdcoder.cn,http://merchandise-demo.birdcoder.cn,https://merchandise-demo.dtupay.cn,http://merchandise-demo.dtupay.cn,https://merchandise-demo.noaper.cn,http://merchandise-demo.noaper.cn,https://merchandise-demo.skubc.com,http://merchandise-demo.skubc.com,https://merchandise-demo.skubc.cn,http://merchandise-demo.skubc.cn,https://merchandise-demo.zowalk.com,http://merchandise-demo.zowalk.com,https://merchandise-demo.zowalk.cn,http://merchandise-demo.zowalk.cn,https://merchandise-demo.offer86.com,http://merchandise-demo.offer86.com,https://merchandise-demo.offer86.cn,http://merchandise-demo.offer86.cn,https://merchandise-demo.86offer.com,http://merchandise-demo.86offer.com,https://merchandise-demo.86offer.cn,http://merchandise-demo.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
