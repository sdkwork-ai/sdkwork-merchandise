# Bootstrap profile cloud.staging — replace with application-specific values.
SDKWORK_MERCHANDISE_DEPLOYMENT_PROFILE=cloud
SDKWORK_MERCHANDISE_ENVIRONMENT=staging
SDKWORK_MERCHANDISE_PROFILE_ID=cloud.staging
SDKWORK_MERCHANDISE_APPLICATION_PUBLIC_HTTP_URL=https://merchandise-staging.sdkwork.com
