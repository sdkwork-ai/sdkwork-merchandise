# Bootstrap profile cloud.demo — independent demonstration deployment, isolated from dev/test/staging/prod.
SDKWORK_MERCHANDISE_DEPLOYMENT_PROFILE=cloud
SDKWORK_MERCHANDISE_ENVIRONMENT=demo
SDKWORK_MERCHANDISE_PROFILE_ID=cloud.demo
SDKWORK_MERCHANDISE_APPLICATION_PUBLIC_HTTP_URL=https://merchandise-demo.sdkwork.com
SDKWORK_MERCHANDISE_PLATFORM_API_GATEWAY_HTTP_URL=https://api-demo.sdkwork.com


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_MERCHANDISE_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN
