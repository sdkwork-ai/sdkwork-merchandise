# cloud.development
SDKWORK_MERCHANDISE_DEPLOYMENT_PROFILE=cloud
SDKWORK_MERCHANDISE_ENVIRONMENT=development
SDKWORK_MERCHANDISE_PROFILE_ID=cloud.development
SDKWORK_MERCHANDISE_PLATFORM_API_GATEWAY_HTTP_URL=https://api.sdkwork.com
SDKWORK_MERCHANDISE_APPLICATION_PUBLIC_HTTP_URL=https://api.sdkwork.com
VITE_SDKWORK_MERCHANDISE_APPLICATION_PUBLIC_HTTP_URL=https://api.sdkwork.com
VITE_SDKWORK_MERCHANDISE_PLATFORM_API_GATEWAY_HTTP_URL=https://api.sdkwork.com

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_MERCHANDISE_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN


# dev:cloud local debugging override (vite dev surface only; PNPM_SCRIPT_SPEC section 3).
# The domain edges above stay authoritative for cloud-mode builds and deployed
# services. The development runtime instead binds every gateway-attached base
# URL to the sdkwork-api-cloud-gateway started by its own dev command
# (bind 127.0.0.1:3900), so dev:cloud quick-starts and debugs against the
# local gateway process.
SDKWORK_LOCAL_PLATFORM_API_GATEWAY_HTTP_URL=http://127.0.0.1:3900
SDKWORK_CORS_ALLOWED_ORIGINS=https://merchandise-dev.sdkwork.com,http://merchandise-dev.sdkwork.com,https://merchandise-dev.birdcoder.com,http://merchandise-dev.birdcoder.com,https://merchandise-dev.dtupay.com,http://merchandise-dev.dtupay.com,https://merchandise-dev.noaper.com,http://merchandise-dev.noaper.com,https://merchandise-dev.sdkwork.cn,http://merchandise-dev.sdkwork.cn,https://merchandise-dev.birdcoder.cn,http://merchandise-dev.birdcoder.cn,https://merchandise-dev.dtupay.cn,http://merchandise-dev.dtupay.cn,https://merchandise-dev.noaper.cn,http://merchandise-dev.noaper.cn,https://merchandise-dev.skubc.com,http://merchandise-dev.skubc.com,https://merchandise-dev.skubc.cn,http://merchandise-dev.skubc.cn,https://merchandise-dev.zowalk.com,http://merchandise-dev.zowalk.com,https://merchandise-dev.zowalk.cn,http://merchandise-dev.zowalk.cn,https://merchandise-dev.offer86.com,http://merchandise-dev.offer86.com,https://merchandise-dev.offer86.cn,http://merchandise-dev.offer86.cn,https://merchandise-dev.86offer.com,http://merchandise-dev.86offer.com,https://merchandise-dev.86offer.cn,http://merchandise-dev.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
